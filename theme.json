{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "accent", "name": "Accent", "color": "#1e6091" },
				{ "slug": "link", "name": "Link", "color": "#1e6091" },
				{ "slug": "text", "name": "Text", "color": "#33414b" },
				{ "slug": "text-strong", "name": "Text strong", "color": "#101820" },
				{ "slug": "bg", "name": "Background", "color": "#f4f8fb" },
				{ "slug": "surface", "name": "Surface", "color": "#ffffff" },
				{ "slug": "border", "name": "Border", "color": "#cbdbe6" },
				{ "slug": "muted", "name": "Muted", "color": "#52616d" },
				{ "slug": "mark", "name": "Mark", "color": "#dbeafe" }
			]
		},
		"typography": {
			"customFontSize": true,
			"defaultFontSizes": false,
			"fluid": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System sans-serif",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\""
				},
				{
					"slug": "serif",
					"name": "System serif",
					"fontFamily": "Charter, \"Bitstream Charter\", \"Sitka Text\", Cambria, Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "sm", "name": "Small", "size": "0.875rem" },
				{ "slug": "base", "name": "Base", "size": "1rem" },
				{ "slug": "lg", "name": "Large", "size": "1.125rem", "fluid": { "min": "1.0625rem", "max": "1.125rem" } },
				{ "slug": "xl", "name": "X-Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.375rem" } },
				{ "slug": "2xl", "name": "2X-Large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "1.75rem" } },
				{ "slug": "3xl", "name": "3X-Large", "size": "2.25rem", "fluid": { "min": "1.875rem", "max": "2.25rem" } }
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "1", "name": "1 — 4px", "size": "0.25rem" },
				{ "slug": "2", "name": "2 — 8px", "size": "0.5rem" },
				{ "slug": "3", "name": "3 — 16px", "size": "1rem" },
				{ "slug": "4", "name": "4 — 24px", "size": "1.5rem" },
				{ "slug": "5", "name": "5 — 32px", "size": "2rem" },
				{ "slug": "6", "name": "6 — 48px", "size": "3rem" },
				{ "slug": "7", "name": "7 — 64px", "size": "4rem" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|bg",
			"text": "var:preset|color|text"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system",
			"fontSize": "var:preset|font-size|base",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|link" }
			},
			"heading": {
				"color": { "text": "var:preset|color|text-strong" },
				"typography": { "fontFamily": "var:preset|font-family|system" }
			}
		}
	}
}
